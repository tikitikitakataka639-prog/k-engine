{
  "name": "k-engine",
  "version": "1.5.0",
  "private": true,
  "description": "K.ENGINE — motor de respuesta para KERNEL: API HTTP (health/models/chat/SSE) + UI React/Vite con WebLLM/WebGPU en el navegador.",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:client": "vite",
    "dev:server": "node server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "node tests/server.test.js && node tests/cache-errors.test.js && node tests/mathTools.test.js && node tests/slm-eval.harness.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:cache": "node tests/cache-errors.test.js",
    "test:math": "node tests/mathTools.test.js",
    "test:slm": "node tests/slm-eval.harness.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/space-grotesk": "^5.1.0",
    "@mlc-ai/web-llm": "0.2.79",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.0.0"
  }
}
